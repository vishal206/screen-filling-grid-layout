{
  "name": "screen-filling-grid-layout",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-owner/screen-filling-grid-layout.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-publish": "publint",
    "check-exports": "attw --pack .",
    "ci": "npm run test && npm run build && npm run check-publish && npm run check-exports",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.2.18",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
